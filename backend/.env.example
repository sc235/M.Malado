# ============================================================================
#  MOJO MALADO — Configuration du serveur
#  Copiez ce fichier vers .env et remplissez les valeurs.
#  Ne versionnez JAMAIS le fichier .env.
# ============================================================================

# --- Base de données (Railway, Neon, Render ou PostgreSQL local) ------------
# Sur Railway : ajoutez un service PostgreSQL, puis référencez sa variable
# depuis le service de l'API avec la syntaxe ${{Postgres.DATABASE_URL}}.
# N'écrivez pas l'adresse en dur : Railway la fait tourner.
DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/mojomalado

# Chiffrement de la connexion : require | disable
#   disable  PostgreSQL local, ou Railway via son réseau privé
#            (…railway.internal), qui ne présente pas de certificat.
#   require  Railway en connexion publique (…proxy.rlwy.net), Render, Neon.
# Laissez vide pour laisser l'hôte décider — mais posez-le en production.
PGSSL=

# --- Sécurité ---------------------------------------------------------------
# ATTENTION : la variable s'appelle bien JWT_SECRET, et non SUPABASE_JWT_SECRET.
# Sans elle, le serveur refuse de démarrer. Générez-en une avec : npm run secret
JWT_SECRET=remplacez_par_une_chaine_aleatoire_de_96_caracteres_minimum

# Origines autorisées à appeler l'API depuis un navigateur (séparées par des virgules).
# Laissez vide en développement pour tout autoriser.
# En production, mettez l'adresse EXACTE du site, sinon l'API reste ouverte à tous.
CORS_ORIGINS=https://mojo-malado.vercel.app,http://localhost:5173

# --- Adresses publiques -----------------------------------------------------
SITE_URL=https://mojo-malado.vercel.app
# Adresse publique de l'API (Railway > Settings > Networking > Public Domain).
API_URL=https://mojomalado-api.up.railway.app

# --- Compte administrateur créé par `npm run seed` --------------------------
ADMIN_EMAIL=contact@mojomalado.com
ADMIN_PASSWORD=changez-ce-mot-de-passe-tout-de-suite

# --- Livraison --------------------------------------------------------------
FREE_SHIPPING_FROM=50000
SHIPPING_DAKAR=2000
SHIPPING_REGIONS=3500

# --- Boutique ---------------------------------------------------------------
SHOP_PHONE=710433624

# --- Paiement en ligne ------------------------------------------------------
# Prestataire actif : wave
PAYMENT_PROVIDER=wave

WAVE_API_KEY=votre_cle_api_wave_business

PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

CINETPAY_API_KEY=
CINETPAY_SITE_ID=

NABOO_API_KEY=

WAVE_API_KEY=

# Secret partagé pour signer les notifications de paiement (si le prestataire le propose).
WEBHOOK_SECRET=

# --- Divers -----------------------------------------------------------------
PORT=5000
RATE_LIMIT_MAX=300

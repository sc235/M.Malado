{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://REMPLACER-PAR-VOTRE-DOMAINE-RAILWAY.up.railway.app/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://REMPLACER-PAR-VOTRE-DOMAINE-RAILWAY.up.railway.app/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|avif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    }
  ]
}
